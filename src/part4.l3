; Signature: last-item(lst)
; Type: List -> T
; Purpose: returns the last item of a non-empty list.
; Pre-conditions: lst is a non-empty list.
; Tests:
; (last-item '(1 2 3)) => 3
; (last-item '(a b c)) => c
(define last-item
  (λ (lst)
    (if (empty? (cdr lst))
        (car lst)
        (last-item (cdr lst)))))


; Signature: remove-last-item(lst)
; Type: List -> List
; Purpose: removes the last item of a non-empty list.
; Pre-conditions: lst is a non-empty list.
; Tests:
; (remove-last-item '(1 2 3)) => '(1 2)
(define remove-last-item
  (λ (lst)
    (if (empty? (cdr lst))
        '()
        (cons (car lst)
              (remove-last-item (cdr lst))))))


; Signature: rotate-nth(lst n)
; Type: List * Natural -> List
; Purpose: gets a list and a number n, and rotates the list n times to the right.
; Pre-conditions: n is a non-negative number.
; Tests:
; (rotate-nth '(1 2 3) 1) => (3 1 2)
(define rotate-nth
  (λ (lst n)
    (if (or (= n 0) (empty? lst))
        lst
        (rotate-nth
         (cons (last-item lst)
               (remove-last-item lst))
         (- n 1)))))


; Signature: deep-reverse(l)
; Type: Nested-List -> Nested-List
; Purpose: returns a list with all elements reversed at every level of nesting.
; Pre-conditions: l is a nested list.
; Tests:
; (deep-reverse '(1 2 3)) => '(3 2 1)
; (deep-reverse '(1 (2 3) (4 5))) => '((5 4) (3 2) 1)
; (deep-reverse '()) => '()
(define deep-reverse
  (λ (l)
    (if (empty? l)
        '()
        (append
         (deep-reverse (cdr l)) 
         (list
          (if (pair? (car l))
              (deep-reverse (car l))
              (car l)))))))